# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI configuration
.terraformrc
terraform.rc

# Variable files - may contain secrets
*.tfvars
*.tfvars.json

# Local lab state backups
state-backups/

# Lab resources generated by Terraform
01-basics/*.txt
02-modules/*.txt
02-modules/*.conf

# Generated dependency graphs
02-modules/graph.dot
02-modules/graph.png

# Generated server resources
03-environments/environments/*/*.txt
